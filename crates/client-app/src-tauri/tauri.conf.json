{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duke Link",
  "version": "0.1.0",
  "identifier": "org.dukelink.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Duke Link",
        "width": 600,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#0e1116"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
