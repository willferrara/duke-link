{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Duke Link",
  "version": "0.1.0",
  "identifier": "org.dukelink.client",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Duke Link",
        "width": 520,
        "height": 640,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#0e1116"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
